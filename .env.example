# Copy of this file is created as .env automatically (never committed).
# Inside the Codespace, NetBox is always reachable at localhost:8000.
NETBOX_URL=http://localhost:8000

# NetBox -> your profile (top right) -> API Tokens -> Add a Token (Write enabled)
# Paste the full token, e.g. nbt_xxxx.yyyy (the "Bearer " prefix is optional)
NETBOX_TOKEN=PASTE_TOKEN_HERE
