hostname {{ hostname }}
banner motd !
{{ std.banner | trim }}
!
clock timezone {{ std.get("timezone", "europe/berlin") | lower }}
{% if has_vrf_ka %}
vrf KA
{% endif %}
{% for s in std.ntp_servers %}
ntp server {{ s }} iburst
{% endfor %}
ntp enable
ntp vrf {{ mgmt_vrf }}
{% for s in std.dns_servers %}
ip dns server-address {{ s }} vrf {{ mgmt_vrf }}
{% endfor %}
{% for s in std.syslog_servers %}
logging {{ s }} vrf {{ mgmt_vrf }}
{% endfor %}
!
ssh server vrf {{ mgmt_vrf }}
https-server vrf {{ mgmt_vrf }}
snmp-server vrf {{ mgmt_vrf }}
snmp-server system-location {{ std.snmp.location_prefix }} {{ location }}
snmpv3 user {{ std.snmp.v3_user }} auth sha auth-pass plaintext <<SNMP_AUTH_PASS>> priv aes priv-pass plaintext <<SNMP_PRIV_PASS>>
